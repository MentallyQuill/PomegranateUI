{
  "name": "pomegranate-ui-incubator",
  "version": "0.0.0-private",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node ./node_modules/@typescript/native/bin/tsc -b && npm run build --workspace @pomegranate-ui/workbench-lab",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:native": "vitest run",
    "test:pack": "node scripts/verify-packed-consumers.mjs",
    "test:browser": "playwright test",
    "pretest:browser": "npm run build",
    "preview:lab": "npm exec --workspace @pomegranate-ui/workbench-lab -- vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "dev:lab": "npm exec --workspace @pomegranate-ui/workbench-lab -- vite --host 127.0.0.1 --port 5173 --strictPort",
    "typecheck": "node ./node_modules/@typescript/native/bin/tsc -b --pretty false && node ./node_modules/@typescript/native/bin/tsc -p tsconfig.tests.json --noEmit --pretty false && npm run typecheck --workspace @pomegranate-ui/workbench-lab && npm run typecheck:svelte",
    "typecheck:svelte": "svelte-check --tsgo --tsconfig ./tsconfig.tests.json",
    "check:extraction": "node scripts/verify-extraction.mjs",
    "check:recipes": "node scripts/verify-recipes.mjs --check",
    "report": "node scripts/generate-migration-report.mjs --check",
    "check": "npm run test:unit && npm run typecheck && npm run test:native && npm run build && npm run check:extraction && npm run check:recipes && npm run report && npm run test:pack && npm run test:browser"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.0",
    "jsdom": "30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "svelte": "5.56.10",
    "svelte-check": "4.7.6",
    "typescript": "6.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
