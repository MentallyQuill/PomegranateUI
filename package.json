{
  "name": "pomegranate-ui-incubator",
  "version": "0.0.0-private",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:browser": "playwright test",
