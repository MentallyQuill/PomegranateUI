{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node", "vitest/globals", "@testing-library/jest-dom"]
  },
  "include": [
    "packages/**/*.test.ts",
    "packages/**/*.svelte",
    "registry/**/*.svelte",
    "apps/**/*.test.ts",
    "apps/**/*.d.ts",
    "apps/**/*.svelte",
    "examples/**/*.test.ts",
    "tests/browser/**/*.ts",
    "tests/conformance/**/*.ts",
    "tests/native/**/*.ts",
    "vitest.config.ts"
  ]
}
